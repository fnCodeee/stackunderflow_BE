DB_PASSWORD=

# JWT (digunakan di Phase 2+)
JWT_SECRET=

# Cloudinary (digunakan di Phase 2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

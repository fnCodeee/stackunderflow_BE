# ─────────────────────────────────────────────────────────────
# .env.example  —  Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke repository
# ─────────────────────────────────────────────────────────────

APP_ENV=development
APP_PORT=8000

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_stack_underflow
DB_USER=root
DB_PASSWORD=

# JWT (digunakan di Phase 2+)
JWT_SECRET=

# Cloudinary (digunakan di Phase 2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Gmail SMTP untuk reset password (2026-11-14)
# SMTP_PASS = App Password Google (16 karakter dari myaccount.google.com/apppasswords),
# BUKAN password akun Google biasa. FRONTEND_URL = alamat frontend untuk link reset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Underflow
FRONTEND_URL=http://localhost:3000
